import json
import os
import time
from datetime import datetime, timedelta, timezone, time as dt_time
from collections import defaultdict
import logging
import typing
import copy

# --- Configuration ---
DEFAULT_JSON_FILE = 'api_keys_manager_data.json'
logger = logging.getLogger(__name__)

# --- Constants ---
CONFIG_PARAMS = [
    'daily_limit', 'requests_per_minute', 'tokens_per_day',
    'tokens_per_minute', 'reset_hour_utc', 'reset_interval_days'
]

# --- Helper Functions for Validation ---

def _validate_positive_int(value: typing.Optional[int], name: str):
    """Raises ValueError if value is not None and not a positive integer."""
    if value is not None and (not isinstance(value, int) or value <= 0):
        raise ValueError(f"{name} must be a positive integer.")

def _validate_reset_hour(value: typing.Optional[int]):
    """Raises ValueError if value is not None and not between 0-23."""
    if value is not None and not (0 <= value <= 23):
        raise ValueError("reset_hour_utc must be between 0 and 23.")

# --- Exceptions ---

class ApiKeyManagerError(Exception):
    """Custom exception for API Key Manager errors."""
    pass

class NoAvailableKeyError(ApiKeyManagerError):
    """Raised when no available key meeting the criteria can be found."""
    pass

# --- Main Class ---

class ApiKeyManager:
    """
    Manages API keys with usage limits (RPD, RPM, TPD, TPM),
    automatic daily usage reset, and temporary cooldowns.
    Configuration is saved in the JSON file.

    *** NOTE: This implementation is NOT thread-safe. ***
    Do not share instances of this class across multiple threads without
    external locking.

    Attributes:
        json_file (str): Path to the JSON file storing key data and config.
        daily_limit (int | None): Max times a key can be used per day (RPD).
        requests_per_minute (int | None): Max requests per minute per key (RPM).
        tokens_per_day (int | None): Max tokens per day per key (TPD).
        tokens_per_minute (int | None): Max tokens per minute per key (TPM).
        reset_hour_utc (int | None): The UTC hour (0-23) when daily usage resets.
        reset_interval_days (int | None): Number of days after which usage resets.
        data (dict): In-memory representation of the JSON data.
                     Includes 'keys', 'config', 'last_reset_time'.
        _key_timestamps (defaultdict): In-memory tracking of recent request timestamps
                                      for RPM limiting. {key: [monotonic_timestamp1,...]}
        _key_token_timestamps (defaultdict): In-memory tracking of recent token usage
                                            for TPM limiting. {key: [(monotonic_timestamp, tokens_used),...]}
        _key_cooldowns (defaultdict): In-memory tracking of key cooldown end times.
                                     {key: end_monotonic_timestamp}
        _active_key (str | None): Stores the key obtained via __enter__ for __exit__.
    """

    def __init__(self,
                 json_file: str = DEFAULT_JSON_FILE,
                 daily_limit: typing.Optional[int] = None,
                 requests_per_minute: typing.Optional[int] = None,
                 tokens_per_day: typing.Optional[int] = None,
                 tokens_per_minute: typing.Optional[int] = None,
                 reset_hour_utc: typing.Optional[int] = None,
                 reset_interval_days: typing.Optional[int] = None):
        """
        Initializes the ApiKeyManager.

        Loads configuration from the JSON file if it exists, but values
        explicitly passed to this constructor (if not None) will take precedence
        and be saved back to the JSON file immediately if they override loaded values.

        Args:
            json_file (str): Path to the JSON file for persistence.
            daily_limit (int | None): Maximum daily requests per key (RPD). Overrides JSON if not None.
            requests_per_minute (int | None): Maximum requests per minute per key (RPM). Overrides JSON if not None.
            tokens_per_day (int | None): Maximum daily tokens per key (TPD). Overrides JSON if not None.
            tokens_per_minute (int | None): Maximum tokens per minute per key (TPM). Overrides JSON if not None.
            reset_hour_utc (int | None): UTC hour (0-23) for daily reset. Overrides JSON if not None.
            reset_interval_days (int | None): Interval in days for usage reset. Overrides JSON if not None.

        Raises:
            ValueError: If limit values passed are not positive integers or reset parameters are invalid.
            ApiKeyManagerError: If there's an issue loading/initializing data.
        """
        # Initial validation of *passed* arguments using helper functions
        _validate_positive_int(daily_limit, 'daily_limit')
        _validate_positive_int(requests_per_minute, 'requests_per_minute')
        _validate_positive_int(tokens_per_day, 'tokens_per_day')
        _validate_positive_int(tokens_per_minute, 'tokens_per_minute')
        _validate_reset_hour(reset_hour_utc)
        _validate_positive_int(reset_interval_days, 'reset_interval_days')

        self.json_file = json_file
        # Store initial args temporarily to compare against loaded values
        self._init_args = {
            'daily_limit': daily_limit,
            'requests_per_minute': requests_per_minute,
            'tokens_per_day': tokens_per_day,
            'tokens_per_minute': tokens_per_minute,
            'reset_hour_utc': reset_hour_utc,
            'reset_interval_days': reset_interval_days,
        }

        # Initialize instance attributes to None first. They will be set by _init_args or loaded values.
        self.daily_limit = None
        self.requests_per_minute = None
        self.tokens_per_day = None
        self.tokens_per_minute = None
        self.reset_hour_utc = None
        self.reset_interval_days = None

        self._key_timestamps = defaultdict(list)
        self._key_token_timestamps = defaultdict(list)
        self._key_cooldowns = defaultdict(float) # Stores end monotonic timestamp
        self._active_key = None
        self.data = None # Will be loaded or initialized

        self._load_or_initialize_data()

        # Final validation of the *effective* configuration (after loading/merging)
        # Uses helper functions for consistency
        _validate_reset_hour(self.reset_hour_utc)
        _validate_positive_int(self.reset_interval_days, 'reset_interval_days')
        _validate_positive_int(self.daily_limit, 'daily_limit')
        _validate_positive_int(self.requests_per_minute, 'requests_per_minute')
        _validate_positive_int(self.tokens_per_day, 'tokens_per_day')
        _validate_positive_int(self.tokens_per_minute, 'tokens_per_minute')

    @staticmethod
    def _get_now_utc() -> datetime:
        """Returns the current time in UTC."""
        return datetime.now(timezone.utc)

    @staticmethod
    def _get_monotonic_time() -> float:
        """Returns the current monotonic time."""
        return time.monotonic()

    def _load_or_initialize_data(self):
        """Loads data and config, merging with init args, or initializes.
           Also performs initial reset check and timestamp cleanup.
        """
        if os.path.exists(self.json_file):
            self._load_from_file()
        else:
            self._initialize_new_file()

        # Perform reset check & cleanup timestamps after loading/initializing
        self._check_and_reset_internal(self._get_now_utc())
        self._cleanup_timestamps_internal()

    def _load_from_file(self):
        """Loads data from the existing JSON file and merges config."""
        now_utc_iso = self._get_now_utc().isoformat()
        config_needs_save = False

        try:
            with open(self.json_file, 'r') as f:
                loaded_data = json.load(f)

            # Basic Validation
            if not isinstance(loaded_data, dict):
                raise ApiKeyManagerError(f"Invalid format in {self.json_file}: root should be a dictionary.")

            # Validate/Initialize 'keys'
            if 'keys' not in loaded_data or not isinstance(loaded_data.get('keys'), dict):
                logger.warning(f"'keys' missing or not a dict in {self.json_file}. Initializing empty.")
                loaded_data['keys'] = {}
                config_needs_save = True # Need to save the corrected structure

            # Validate/Initialize 'last_reset_time'
            try:
                reset_time_str = loaded_data.get('last_reset_time')
                if reset_time_str:
                    datetime.fromisoformat(str(reset_time_str).replace('Z', '+00:00'))
                else:
                    raise ValueError("Missing last_reset_time")
            except (ValueError, AttributeError, TypeError):
                logger.warning(f"Invalid or missing 'last_reset_time' in {self.json_file}. Setting to current time.")
                loaded_data['last_reset_time'] = now_utc_iso
                config_needs_save = True

            # Validate/Initialize 'config'
            saved_config = loaded_data.get('config', {})
            if not isinstance(saved_config, dict):
                logger.warning(f"'config' is not a dict in {self.json_file}. Initializing empty.")
                saved_config = {}
            loaded_data['config'] = saved_config # Ensure 'config' key exists

            # Merge saved config with init args
            effective_config, config_merged = self._merge_configs(saved_config)
            if config_merged:
                config_needs_save = True

            # Update instance attributes from the effective config
            for param, value in effective_config.items():
                setattr(self, param, value)

            # Validate and potentially correct key data
            keys_data_corrected = self._validate_and_correct_key_data(loaded_data.get('keys', {}))

            self.data = loaded_data
            # Update config dict *within* self.data *before* potential save
            self.data['config'] = self._get_current_config()

            # Save immediately if configuration was overridden or data was corrected
            if config_needs_save or keys_data_corrected:
                if config_needs_save:
                    logger.info(f"Configuration updated during initialization. Saving changes to {self.json_file}.")
                if keys_data_corrected:
                    logger.info(f"Key usage data corrected during initialization. Saving changes to {self.json_file}.")
                self._save_data_internal()

        except json.JSONDecodeError as e:
            raise ApiKeyManagerError(f"Error decoding JSON from {self.json_file}: {e}")
        except Exception as e:
            raise ApiKeyManagerError(f"Error processing data from {self.json_file}: {e}")

    def _initialize_new_file(self):
        """Initializes data structure for a new file."""
        logger.info(f"JSON file '{self.json_file}' not found. Initializing new data structure.")
        # Use the init args provided (which might be None)
        for param, value in self._init_args.items():
            if value is not None:
                setattr(self, param, value)

        self.data = {
            'keys': {},
            'config': self._get_current_config(),
            'last_reset_time': self._get_now_utc().isoformat()
        }
        self._save_data_internal() # Save initial structure immediately

    def _merge_configs(self, saved_config: dict) -> tuple[dict, bool]:
        """Merges saved config with init args, returning effective config and a flag if changes were made."""
        effective_config = {}
        config_changed = False
        for param in CONFIG_PARAMS:
            init_val = self._init_args.get(param)
            saved_val = saved_config.get(param)

            if init_val is not None:
                effective_config[param] = init_val
                if saved_val != init_val or param not in saved_config:
                    if saved_val != init_val and saved_val is not None:
                         logger.warning(f"Initialization value for '{param}' ({init_val}) overrides saved value ({saved_val}) in {self.json_file}.")
                    config_changed = True
            elif saved_val is not None:
                effective_config[param] = saved_val
                logger.info(f"Loaded '{param}' ({saved_val}) from {self.json_file}.")
            else:
                effective_config[param] = None
                if param not in saved_config:
                    config_changed = True # Ensure key exists in saved config eventually

        return effective_config, config_changed

    def _validate_and_correct_key_data(self, keys_dict: dict) -> bool:
        """Validates usage fields in loaded keys, corrects if necessary, returns True if correction occurred."""
        keys_data_corrected = False
        for key, key_data in keys_dict.items():
            if not isinstance(key_data, dict):
                logger.warning(f"Invalid data format for key '{key}'. Resetting.")
                keys_dict[key] = {"usage_today": 0, "tokens_today": 0}
                keys_data_corrected = True
                continue

            usage_updated = False
            if not isinstance(key_data.get('usage_today'), (int, float)) or key_data.get('usage_today', 0) < 0:
                logger.warning(f"'usage_today' missing or invalid for key '{key}'. Setting to 0.")
                key_data['usage_today'] = 0
                usage_updated = True
            if not isinstance(key_data.get('tokens_today'), (int, float)) or key_data.get('tokens_today', 0) < 0:
                 logger.warning(f"'tokens_today' missing or invalid for key '{key}'. Setting to 0.")
                 key_data['tokens_today'] = 0
                 usage_updated = True
            if usage_updated:
                 keys_data_corrected = True
        return keys_data_corrected

    def _get_current_config(self) -> dict:
        """Returns a dictionary of the current instance configuration attributes."""
        return {
            param: getattr(self, param, None) for param in CONFIG_PARAMS
        }

    def _save_data_internal(self):
        """Saves the current state of self.data to the JSON file, ensuring data integrity."""
        if not self.data:
            logger.error("Attempted to save data, but self.data is not initialized.")
            return

        try:
            # Ensure config dict in data reflects current instance state before saving
            self.data['config'] = self._get_current_config()

            # Ensure last reset time is valid ISO format before saving
            last_reset_time_str = self.data.get('last_reset_time')
            try:
                 datetime.fromisoformat(str(last_reset_time_str).replace('Z', '+00:00'))
            except (ValueError, AttributeError, TypeError):
                 now_iso = self._get_now_utc().isoformat()
                 logger.error(f"Invalid 'last_reset_time' ({last_reset_time_str}) format before saving. Forcing current time: {now_iso}.")
                 self.data['last_reset_time'] = now_iso

            # Ensure usage data is non-negative numeric
            self._validate_and_correct_key_data(self.data.get('keys', {}))

            # Atomic write using temp file
            temp_file = self.json_file + ".tmp"
            with open(temp_file, 'w') as f:
                json.dump(self.data, f, indent=4)

            try:
                os.replace(temp_file, self.json_file)
            except OSError as e:
                # Handle common Windows error (183: Cannot create a file when that file already exists)
                # Also handle PermissionError
                if (hasattr(e, 'winerror') and e.winerror == 183 and os.path.exists(self.json_file)) or isinstance(e, PermissionError):
                    logger.warning(f"os.replace failed ({e}), attempting remove and rename fallback.")
                    try:
                        os.remove(self.json_file)
                        os.rename(temp_file, self.json_file)
                    except OSError as e2:
                         logger.error(f"Failed to replace/rename file after fallback attempt: {e2}")
                         if os.path.exists(temp_file):
                             try: os.remove(temp_file)
                             except OSError: pass
                         raise ApiKeyManagerError(f"Failed to save data to {self.json_file} after fallback: {e2}") from e2
                else:
                    raise # Re-raise original error if it's not the expected one

        except IOError as e:
            logger.error(f"Failed to write data to {self.json_file} or temp file: {e}")
            raise ApiKeyManagerError(f"IOError saving data: {e}") from e
        except Exception as e:
            logger.error(f"An unexpected error occurred during save: {e}")
            if 'temp_file' in locals() and os.path.exists(temp_file):
                 try: os.remove(temp_file)
                 except OSError: pass
            raise ApiKeyManagerError(f"Unexpected error saving data: {e}") from e


    def _check_and_reset_internal(self, now_utc: datetime):
        """Checks if daily limits need resetting based on rules and performs the reset."""
        if not self.data: return

        last_reset_time = self._parse_last_reset_time()
        original_last_reset_iso = last_reset_time.isoformat() if last_reset_time else None

        if last_reset_time is None:
             # If parsing failed or time was missing, force reset time to now and save.
             last_reset_time = now_utc
             new_reset_time_iso = now_utc.isoformat()
             self.data['last_reset_time'] = new_reset_time_iso
             logger.warning(f"Invalid or missing 'last_reset_time'. Setting to current check time: {new_reset_time_iso}")
             self._save_data_internal()
             return # No reset check needed on this run

        # Calculate next reset time based on rules
        next_reset_occurrence = self._calculate_next_reset_time(last_reset_time)

        # Determine if reset is needed
        reset_needed = (next_reset_occurrence is not None) and (now_utc >= next_reset_occurrence)
        reason = self._get_reset_reason(last_reset_time, next_reset_occurrence)

        if reset_needed:
            logger.info(f"Resetting daily usage counts. Reason: {reason}. Last reset: {last_reset_time.isoformat()}. Check time: {now_utc.isoformat()}")
            keys_updated = self._perform_usage_reset()
            new_reset_time_iso = now_utc.isoformat() # Use current time as the new reset time
            self.data['last_reset_time'] = new_reset_time_iso

            # Determine if save is required
            save_required = self._determine_if_save_needed_after_reset(
                keys_updated, reason, original_last_reset_iso, new_reset_time_iso
            )

            if save_required:
                 self._save_data_internal()

    def _parse_last_reset_time(self) -> typing.Optional[datetime]:
        """Parses the last reset time string from data into a timezone-aware UTC datetime object."""
        last_reset_str = self.data.get('last_reset_time')
        if not last_reset_str:
            return None
        try:
            parsed_time = datetime.fromisoformat(str(last_reset_str).replace('Z', '+00:00'))
            if parsed_time.tzinfo is None:
                return parsed_time.replace(tzinfo=timezone.utc)
            elif parsed_time.tzinfo != timezone.utc:
                 return parsed_time.astimezone(timezone.utc)
            else:
                return parsed_time
        except (ValueError, TypeError):
            logger.error(f"Could not parse last_reset_time '{last_reset_str}'.")
            return None

    def _calculate_next_reset_time(self, last_reset_time: datetime) -> typing.Optional[datetime]:
        """Calculates the next scheduled reset time based on config rules."""
        next_reset_by_interval = None
        next_reset_by_hour = None

        # Calculate based on interval
        if self.reset_interval_days is not None and self.reset_interval_days > 0:
            next_reset_by_interval = last_reset_time + timedelta(days=self.reset_interval_days)

        # Calculate based on daily reset hour
        if self.reset_hour_utc is not None:
            reset_dt = dt_time(self.reset_hour_utc, tzinfo=timezone.utc)
            potential_reset_this_cycle = datetime.combine(last_reset_time.date(), reset_dt)

            if potential_reset_this_cycle <= last_reset_time:
                # Reset time for the day of the last reset has passed. Next is tomorrow.
                next_reset_by_hour = datetime.combine(last_reset_time.date() + timedelta(days=1), reset_dt)
            else:
                # Reset time is later today (relative to last reset).
                next_reset_by_hour = potential_reset_this_cycle

        # Determine the earliest applicable next reset time
        if next_reset_by_interval and next_reset_by_hour:
            return min(next_reset_by_interval, next_reset_by_hour)
        else:
            return next_reset_by_interval or next_reset_by_hour # Return whichever is not None

    def _get_reset_reason(self, last_reset_time: datetime, next_reset_occurrence: typing.Optional[datetime]) -> str:
        """Determines the reason string for why a reset might be needed."""
        if next_reset_occurrence is None: return "No reset configured"

        reason_interval = ""
        if self.reset_interval_days is not None and self.reset_interval_days > 0:
             potential_interval_reset = last_reset_time + timedelta(days=self.reset_interval_days)
             if potential_interval_reset == next_reset_occurrence:
                 reason_interval = f"interval of {self.reset_interval_days} days"

        reason_hour = ""
        if self.reset_hour_utc is not None:
            # Check if the next reset time matches the hour-based calculation logic
            reset_dt = dt_time(self.reset_hour_utc, tzinfo=timezone.utc)
            potential_reset_this_cycle = datetime.combine(last_reset_time.date(), reset_dt)
            potential_next_day_reset = datetime.combine(last_reset_time.date() + timedelta(days=1), reset_dt)

            if (potential_reset_this_cycle > last_reset_time and next_reset_occurrence == potential_reset_this_cycle) or \
               (potential_reset_this_cycle <= last_reset_time and next_reset_occurrence == potential_next_day_reset):
                 reason_hour = f"daily reset hour UTC {self.reset_hour_utc:02d}:00"

        if reason_interval and reason_hour:
            return f"Passed {reason_interval} and {reason_hour}"
        elif reason_interval:
            return f"Passed {reason_interval}"
        elif reason_hour:
            return f"Passed {reason_hour}"
        else:
            # Should not happen if next_reset_occurrence is not None, but handle defensively
            return f"Calculated reset time {next_reset_occurrence.isoformat()} passed"

    def _perform_usage_reset(self) -> int:
        """Resets usage_today and tokens_today for all keys. Returns count of updated keys."""
        keys_updated = 0
        for key, key_data in self.data.get('keys', {}).items():
            if isinstance(key_data, dict):
                usage_reset = False
                if key_data.get('usage_today', 0) != 0:
                    key_data['usage_today'] = 0
                    usage_reset = True
                if key_data.get('tokens_today', 0) != 0:
                    key_data['tokens_today'] = 0
                    usage_reset = True
                if usage_reset:
                    keys_updated += 1
            else:
                logger.warning(f"Skipping reset for non-dict key data for key '{key[:4]}...{key[-4:]}': {key_data}")
        if keys_updated > 0:
             logger.info(f"Reset daily usage for {keys_updated} keys.")
        else:
             logger.info("Reset time passed, but no key usage needed resetting.")
        return keys_updated

    def _determine_if_save_needed_after_reset(self, keys_updated: int, reason: str, original_iso: typing.Optional[str], new_iso: str) -> bool:
        """Determines if saving is necessary after a reset check."""
        if keys_updated > 0:
            return True # Always save if counts were reset
        # Save if interval triggered, as timestamp *must* update
        if self.reset_interval_days is not None and "interval" in reason:
            logger.info("Interval reset triggered, saving updated last_reset_time even though usage counts were zero.")
            return True
        # Save if the timestamp actually changed (covers edge cases, like first run after manual edit)
        if original_iso is None or new_iso != original_iso:
            logger.info(f"Saving updated last_reset_time ({new_iso}) as it changed from original ({original_iso}).")
            return True
        # Otherwise (e.g., hour-based reset passed but counts were already 0), no save needed
        return False

    def _cleanup_timestamps_internal(self):
        """Removes timestamps older than 1 minute from internal tracking and expired cooldowns."""
        now_mono = self._get_monotonic_time()
        cutoff = now_mono - 60.0 # 60 seconds cutoff

        # Cleanup RPM timestamps (_key_timestamps)
        if self.requests_per_minute is not None:
            self._cleanup_rpm_timestamps(cutoff)

        # Cleanup TPM timestamps (_key_token_timestamps)
        if self.tokens_per_minute is not None:
            self._cleanup_tpm_timestamps(cutoff)

        # Cleanup expired cooldowns (_key_cooldowns)
        self._cleanup_cooldowns(now_mono)

    def _cleanup_rpm_timestamps(self, cutoff: float):
        """Removes old timestamps from _key_timestamps."""
        keys_to_clear = []
        for key, timestamps in list(self._key_timestamps.items()):
            valid_timestamps = [ts for ts in timestamps if ts >= cutoff]
            if valid_timestamps:
                self._key_timestamps[key] = valid_timestamps
            else:
                keys_to_clear.append(key)
        for key in keys_to_clear:
            self._key_timestamps.pop(key, None)

    def _cleanup_tpm_timestamps(self, cutoff: float):
        """Removes old entries from _key_token_timestamps."""
        keys_to_clear = []
        for key, entries in list(self._key_token_timestamps.items()):
            valid_entries = [(ts, tokens) for ts, tokens in entries if ts >= cutoff]
            if valid_entries:
                self._key_token_timestamps[key] = valid_entries
            else:
                keys_to_clear.append(key)
        for key in keys_to_clear:
            self._key_token_timestamps.pop(key, None)

    def _cleanup_cooldowns(self, now_mono: float):
        """Removes expired or irrelevant cooldowns from _key_cooldowns."""
        keys_to_clear = []
        current_keys = self.data.get('keys', {}).keys()
        for key, expiry_time in list(self._key_cooldowns.items()):
            if expiry_time <= now_mono or key not in current_keys:
                keys_to_clear.append(key)
                if key in self._key_cooldowns: # Check if not already popped
                    if expiry_time <= now_mono and key in current_keys:
                        logger.debug(f"Cooldown expired for key {key[:4]}...{key[-4:]}")
                    elif key not in current_keys:
                        logger.debug(f"Removing cooldown for key {key[:4]}...{key[-4:]} as key no longer exists.")

        for key in keys_to_clear:
            self._key_cooldowns.pop(key, None)

    def add_key(self, api_key: str):
        """Adds a new API key to the manager."""
        if not api_key or not isinstance(api_key, str):
            raise ValueError("API key must be a non-empty string.")

        self._check_and_reset_internal(self._get_now_utc())

        if 'keys' not in self.data or not isinstance(self.data['keys'], dict):
            self.data['keys'] = {}

        if api_key in self.data['keys']:
            raise ApiKeyManagerError(f"API key ending with '...{api_key[-4:]}' already exists.")

        self.data['keys'][api_key] = {"usage_today": 0, "tokens_today": 0}
        logger.info(f"Added new API key: {api_key[:4]}...{api_key[-4:]}")
        self._save_data_internal()

    def remove_key(self, api_key: str):
        """Removes an API key from the manager."""
        self._check_and_reset_internal(self._get_now_utc())

        if 'keys' not in self.data or api_key not in self.data.get('keys', {}):
            raise ApiKeyManagerError(f"API key '{api_key[:4]}...{api_key[-4:]}' not found.")

        del self.data['keys'][api_key]
        self._key_timestamps.pop(api_key, None)
        self._key_token_timestamps.pop(api_key, None)
        self._key_cooldowns.pop(api_key, None)

        logger.info(f"Removed API key: {api_key[:4]}...{api_key[-4:]}")
        self._save_data_internal()

    def is_key_usable(self, key: str, key_data: dict, now_mono: float) -> bool:
        """Checks if a single key is currently usable based on all limits."""
        if not isinstance(key_data, dict):
            logger.warning(f"Invalid key_data for key {key[:4]}...{key[-4:]}. Marking unusable.")
            return False

        # 1. Cooldown
        if key in self._key_cooldowns and self._key_cooldowns[key] > now_mono:
            return False

        # 2. RPD
        if self.daily_limit is not None and key_data.get('usage_today', 0) >= self.daily_limit:
            return False

        # 3. TPD
        if self.tokens_per_day is not None and key_data.get('tokens_today', 0) >= self.tokens_per_day:
            return False

        # 4. RPM (Assumes cleanup ran recently)
        if self.requests_per_minute is not None and len(self._key_timestamps.get(key, [])) >= self.requests_per_minute:
            return False

        # 5. TPM (Assumes cleanup ran recently)
        if self.tokens_per_minute is not None:
            current_minute_tokens = sum(tokens for ts, tokens in self._key_token_timestamps.get(key, []))
            if current_minute_tokens >= self.tokens_per_minute:
                return False

        return True

    def get_key(self) -> str:
        """
        Returns a single available API key.
        Raises NoAvailableKeyError if no keys are configured or all are unusable.
        """
        self._check_and_reset_internal(self._get_now_utc())
        self._cleanup_timestamps_internal()
        now_mono = self._get_monotonic_time()

        keys_data = self.data.get('keys')
        if not keys_data:
            raise NoAvailableKeyError("No API keys configured.")

        for key, key_data in keys_data.items():
            if self.is_key_usable(key, key_data, now_mono):
                return key

        raise NoAvailableKeyError("All API keys have reached limits or are on cooldown.")

    def get_keys(self, n: int = 1) -> typing.List[str]:
        """
        Returns a list of up to 'n' available API keys.
        Raises NoAvailableKeyError only if no keys are configured at all.
        Returns empty list if keys exist but none are usable.
        """
        if n <= 0: n = 1

        self._check_and_reset_internal(self._get_now_utc())
        self._cleanup_timestamps_internal()
        now_mono = self._get_monotonic_time()

        keys_data = self.data.get('keys')
        if not keys_data:
             raise NoAvailableKeyError("No API keys configured.")

        usable_keys = []
        for key, key_data in keys_data.items():
            if self.is_key_usable(key, key_data, now_mono):
                usable_keys.append(key)
                if len(usable_keys) == n:
                    break
        return usable_keys

    def record_usage(self, api_key: str, tokens_used: int = 1):
        """
        Records usage for a specific API key, updating daily and minute counts.

        Args:
            api_key (str): The API key used.
            tokens_used (int): Tokens consumed (non-negative). Defaults to 1.

        Raises:
            ApiKeyManagerError: If key not found or data structure is invalid.
            ValueError: If tokens_used is negative or api_key is invalid.
        """
        if not isinstance(tokens_used, int) or tokens_used < 0:
            raise ValueError("tokens_used must be a non-negative integer.")
        if not api_key or not isinstance(api_key, str):
            raise ValueError("api_key must be a non-empty string.")

        self._check_and_reset_internal(self._get_now_utc())
        self._cleanup_timestamps_internal()
        now_mono = self._get_monotonic_time()

        if 'keys' not in self.data or api_key not in self.data['keys']:
            raise ApiKeyManagerError(f"Attempted to record usage for unknown key: {api_key[:4]}...{api_key[-4:]}")

        key_data = self.data['keys'][api_key]
        if not isinstance(key_data, dict):
             logger.error(f"Data for key {api_key[:4]}... invalid. Cannot record usage.")
             raise ApiKeyManagerError(f"Invalid data structure for key {api_key[:4]}...{api_key[-4:]}.")

        # Increment persistent daily counters
        key_data['usage_today'] = key_data.get('usage_today', 0) + 1
        if tokens_used > 0:
             key_data['tokens_today'] = key_data.get('tokens_today', 0) + tokens_used

        # Add to in-memory minute counters
        if self.requests_per_minute is not None:
            self._key_timestamps[api_key].append(now_mono)
        if self.tokens_per_minute is not None and tokens_used > 0:
            self._key_token_timestamps[api_key].append((now_mono, tokens_used))

        self._save_data_internal()

    def mark_unusable(self, api_key: str, cooldown_seconds: int = 60):
        """
        Marks a key as unusable (in-memory cooldown).

        Args:
            api_key (str): The key to mark.
            cooldown_seconds (int): Cooldown duration (non-negative). Defaults to 60.

        Raises:
            ApiKeyManagerError: If key not found.
            ValueError: If cooldown_seconds is negative.
        """
        if not isinstance(cooldown_seconds, int) or cooldown_seconds < 0:
            raise ValueError("cooldown_seconds must be a non-negative integer.")

        if 'keys' not in self.data or api_key not in self.data['keys']:
            raise ApiKeyManagerError(f"Cannot mark unknown key as unusable: {api_key[:4]}...{api_key[-4:]}")

        now_mono = self._get_monotonic_time()
        cooldown_end_time = now_mono + cooldown_seconds
        self._key_cooldowns[api_key] = cooldown_end_time
        logger.info(f"Marked key {api_key[:4]}... unusable for {cooldown_seconds}s (until monotonic {cooldown_end_time:.2f}).")
        # No save needed - transient state

    def get_usage_stats(self) -> dict:
        """Returns current daily usage stats (deep copy) after ensuring data is current."""
        self._check_and_reset_internal(self._get_now_utc())
        return copy.deepcopy(self.data.get('keys', {}))

    def get_config(self) -> dict:
        """ Returns a copy of the current configuration."""
        self.data['config'] = self._get_current_config()
        return copy.deepcopy(self.data.get('config', {}))

    def get_last_reset_time(self) -> typing.Optional[datetime]:
        """ Returns the last reset time as a timezone-aware UTC datetime object, or None."""
        return self._parse_last_reset_time()

    def __enter__(self):
        """Context manager entry: gets a single available key."""
        self._active_key = self.get_key()
        return self._active_key

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit: records usage (1 req, 1 token) if no exception occurred."""
        key_to_record = self._active_key
        self._active_key = None

        if exc_type is None and key_to_record:
            try:
                self.record_usage(key_to_record, tokens_used=1)
            except (ApiKeyManagerError, ValueError, Exception) as e:
                 logger.error(f"Error recording usage in __exit__ for key '{key_to_record[:4]}...': {e}", exc_info=True)

        return False # Re-raise exceptions from the 'with' block
